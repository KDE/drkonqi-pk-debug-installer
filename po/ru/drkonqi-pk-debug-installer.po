#: qml/DebugRepoPage.qml:12
msgctxt "@title"
msgid "Debug Symbols Sources"
msgstr "Источники отладочных символов"

#: qml/DebugRepoPage.qml:37
msgctxt "@label/rich"
msgid ""
"<p>Additional software sources need to be enabled on this system before "
"debug symbols can be reliably resolved.</p><p>This can be undone in Discover."
"</p>"
msgstr ""
"<p>Для надёжного поиска отладочных символов в системе необходимо включить "
"дополнительные источники программного обеспечения.</p><p>Отменить это можно "
"в Discover.</p>"

#: qml/DebugRepoPage.qml:75
msgctxt "@button"
msgid "Add Missing Software Sources"
msgstr "Добавить недостающие источники"

